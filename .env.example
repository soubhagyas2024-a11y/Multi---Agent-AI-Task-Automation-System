# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
TAVILY_API_KEY=
# Leave blank to auto-generate and persist in data/.secret_key
SECRET_KEY=
DATABASE_URL=
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
AGENTFLOW_API_URL=http://127.0.0.1:8000
MAX_RETRIES=2
TASK_TIMEOUT_SECONDS=600
MAX_UPLOAD_MB=10
